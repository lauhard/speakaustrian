{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "speakaustrian",
	"compatibility_date": "2026-11-06",
	"compatibility_flags": [
		"nodejs_als"
	],
	// Runs before every `wrangler deploy`, so the Cloudflare build needs no extra build command.
	// Must not call wrangler itself (wrangler runs this command, that would loop).
	"build": {
		"command": "pnpm exec vite build"
	},
	"main": ".svelte-kit/cloudflare/_worker.js",
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	// Required by `wrangler preview` (branch previews in Workers Builds); may stay empty.
	"previews": {}
}
