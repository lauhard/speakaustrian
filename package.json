{
	"name": "speakaustrian",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "wrangler dev .svelte-kit/cloudflare/_worker.js --port 4173",
		"prepare": "svelte-kit sync || echo ''",
		"check": "pnpm i18n && wrangler types && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:e2e": "playwright test",
		"test": "vitest run",
		"qa": "node --disable-warning=ExperimentalWarning scripts/qa/run.ts",
		"gen": "wrangler types",
		"test:watch": "vitest",
		"deploy": "wrangler deploy",
		"i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --emit-ts-declarations --silent"
	},
	"devDependencies": {
		"@fontsource-variable/archivo": "^5.3.0",
		"@fontsource-variable/nunito": "^5.3.0",
		"@inlang/paraglide-js": "^2.18.2",
		"@inlang/plugin-m-function-matcher": "^2.4.3",
		"@inlang/plugin-message-format": "^4.6.0",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-cloudflare": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"svelte": "^5.57.2",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.0",
		"vitest": "^5.1.0",
		"wrangler": "^4.97.0",
		"zod": "^4.6.7"
	}
}
